# מפתח ה-API של מודל השפה. נקרא רק בצד השרת (Netlify Functions) - בלי קידומת
# VITE_, כדי שלעולם לא ייכלל בקוד ה-JavaScript שנשלח לדפדפן.
# העתק קובץ זה ל-.env ומלא את הערך שלך. אל תשתף את הקובץ .env או תעלה אותו ל-git.
LLM_API_KEY=

# כתובת ה-API של מודל השפה. ברירת המחדל מיועדת ל-OpenAI Chat Completions API.
LLM_API_URL=https://api.openai.com/v1/chat/completions

# שם המודל לשימוש.
LLM_MODEL=gpt-4o-mini

# --- Google AdSense (אופציונלי) ---
# פרסומות לא יוצגו כלל עד שממלאים את שני הערכים האלה. יש ליצור חשבון
# Google AdSense משלכם, לחכות לאישור האתר, וליצור יחידות מודעה (ad units).
# את מזהה המפרסם (משותף לכל האתר) לוקחים מתוך קטע הקוד ש-AdSense נותן לכם
# (נראה כמו ca-pub-1234567890123456). ערכים אלה נחשפים לדפדפן במתכוון -
# הם ציבוריים מטבעם ומופיעים תמיד בקוד המקור של כל אתר עם AdSense.
VITE_ADSENSE_CLIENT_ID=

# מזהה יחידת מודעה (ad slot) לבאנר שמתחת לכותרת העליונה.
VITE_ADSENSE_SLOT_BANNER=

# מזהה יחידת מודעה (ad slot) לתיבה בסרגל הצד (מתחת ללוח המהלכים / פאנל המאמן).
VITE_ADSENSE_SLOT_SIDEBAR=
